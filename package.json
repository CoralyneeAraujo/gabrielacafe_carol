{
  "name": "nosso-cantinho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "android:live": "node tools/cap-mode.mjs live && npx cap sync android",
    "android:sync": "node tools/cap-mode.mjs release && npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@fontsource/fredoka": "^5.0.0",
    "@fontsource/nunito": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
